---
import Icon from './Icon.astro';
---
<aside class="companion" aria-label="Orbit companion" data-companion data-state="idle" hidden>
  <button class="orbit-restore icon-button" type="button" aria-label="Restore Orbit" data-orbit-restore hidden>
    <Icon name="expand" size={19} />
  </button>
  <button class="orbit-trigger" type="button" aria-label="Orbit" aria-expanded="false" aria-controls="orbit-panel" data-orbit-trigger>
    <svg class="orbit-robot" width="48" height="48" viewBox="0 0 48 48" aria-hidden="true" fill="none">
      <path d="M24 13V7m-14 17H7v9h4m27-9h3v9h-4" stroke="#8DA5FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="24" cy="7" r="2.5" fill="#78E4C6"/>
      <rect x="10" y="13" width="28" height="26" rx="9" fill="#7897F8" stroke="#ABC0FF" stroke-width="1.3"/>
      <rect x="13.5" y="19" width="21" height="14" rx="5" fill="#101A33"/>
      <g class="orbit-eyes" fill="#79E9CC">
        <rect x="17.5" y="23.5" width="3.3" height="5.4" rx="1.65"/>
        <rect x="27.2" y="23.5" width="3.3" height="5.4" rx="1.65"/>
      </g>
      <path d="M21.5 36h5" stroke="#D8E4FF" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="orbit-panel tile" id="orbit-panel" data-orbit-panel hidden>
    <div class="orbit-panel-header flex items-center justify-between">
      <p class="orbit-title">Orbit</p>
      <div class="flex">
        <button class="icon-button" type="button" aria-label="Minimize Orbit" data-orbit-minimize><Icon name="minus" size={17} /></button>
        <button class="icon-button" type="button" aria-label="Close Orbit panel" data-orbit-close><Icon name="close" size={17} /></button>
      </div>
    </div>
    <p class="orbit-message" data-orbit-message aria-live="polite"></p>
    <nav aria-label="Orbit shortcuts">
      <ul class="orbit-links">
        <li><a href="#work">Projects</a></li>
        <li><a href="#expertise">Expertise</a></li>
        <li><a href="#resume">Résumé</a></li>
      </ul>
    </nav>
  </div>
</aside>
<script>
  import { initializeCompanion } from '../scripts/companion';
  initializeCompanion();
</script>
